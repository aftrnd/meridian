-static char *create_preloader_link(const char *wineloader_path, const char *exe_name)
+/* Meridian: a game runs from its own copy of the loader, in an app bundle. macOS
+ * gives Game Mode only to a process whose executable is inside a bundle that says
+ * it is a game (gamepolicyd: "labelReason=LSSupportsGameMode (Info.plist)"), and
+ * it finds the bundle from the kernel's path for the executable. For a file with
+ * several hard links that path is the name looked up last, and a Wine session
+ * looks the loader up under its other names all the time: as a link in the
+ * bundle, the game was ignored (Nov 24 2026; a stand-in was taken for a game 6
+ * times of 6 as a copy, and 6 times of 12 as a link). So each game gets a clone
+ * of the loader, which takes no disk space. The engine ships "Meridian Game.app"
+ * beside the loader: its Info.plist is the loader's embedded one byte for byte,
+ * which is what the loader's signature covers, and its MacOS directory holds the
+ * ntdll.so link the loader looks for beside itself. That plist has no
+ * CFBundleName: with one, the Dock would call every game in the bundle by it,
+ * and without one each keeps its executable's name, as outside a bundle. A game
+ * is an executable in a Steam library (steamapps/common); Steam, its helpers and
+ * Wine's own processes keep their links in the temporary directory. Returns the
+ * bundle's directory with room for exe_name, or NULL when the temporary
+ * directory is where this program belongs.
+ */
+static char *game_bundle_dir(const char *wineloader_path, const char *exe_name, const char *image_path)
 {
+    static const char bundle[] = "Meridian Game.app/Contents/MacOS/";
+    const char *slash = strrchr(wineloader_path, '/');
+    char *p, *dir, *image = strdup(image_path);
+    int is_game;
+
+    if (!image) return NULL;
+    for (p = image; *p; p++) if (*p == '\\') *p = '/';
+    is_game = strcasestr(image, "/steamapps/common/") != NULL;
+    free(image);
+    if (!is_game || !slash) return NULL;
+
+    if (!(dir = malloc(MAX_PATH))) return NULL;
+    if (snprintf(dir, MAX_PATH, "%.*s/%s", (int)(slash - wineloader_path), wineloader_path, bundle)
+            + strlen(exe_name) < MAX_PATH && !access(dir, W_OK | X_OK))
+        return dir;
+    free(dir);
+    return NULL;
+}
+
+/* Meridian: puts the game's own copy of the loader at path. Returns 0 when it is there. */
+static int clone_loader_for_game(const char *wineloader_path, const char *path)
+{
+    struct stat st, loader_st;
+
+    if (stat(wineloader_path, &loader_st)) return -1;
+    if (!lstat(path, &st))
+    {
+        /* A clone keeps the loader's size and modification time. One made from this
+         * loader is used again (the game's other processes run from it); one left by
+         * a loader since replaced, or a link to the loader, is made anew.
+         */
+        if (S_ISREG(st.st_mode) && st.st_ino != loader_st.st_ino && st.st_size == loader_st.st_size &&
+            st.st_mtimespec.tv_sec == loader_st.st_mtimespec.tv_sec &&
+            st.st_mtimespec.tv_nsec == loader_st.st_mtimespec.tv_nsec)
+            return 0;
+        unlink(path);
+    }
+    /* EEXIST: another process of the same game made it a moment ago. */
+    if (!clonefile(wineloader_path, path, 0) || errno == EEXIST) return 0;
+    ERR("no copy of the loader at %s (%s): the game runs without Game Mode\n", debugstr_a(path), strerror(errno));
+    return -1;
+}
